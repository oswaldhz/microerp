# Base de datos (usa el puerto 5433 del docker-compose.yml)
DATABASE_URL="postgresql://microerp:microerp@localhost:5433/microerp?schema=public"

# Secreto para firmar los tokens JWT de sesion (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="cambia-este-secreto"

# Duracion de la sesion en horas
SESSION_TTL_HOURS="12"